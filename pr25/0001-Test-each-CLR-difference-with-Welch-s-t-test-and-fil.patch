diff --git a/config/defaults/pipeline.yml b/config/defaults/pipeline.yml
index 15c4f74..14d17d6 100644
--- a/config/defaults/pipeline.yml
+++ b/config/defaults/pipeline.yml
@@ -349,8 +349,9 @@ analysis:
   differential:
     # The model fitted to each taxon. nb_glm: a negative-binomial GLM on the read
     # counts with a library-size offset; the effect is a log2 fold change. clr_lm:
-    # a linear model on centred log-ratios after multiplicative replacement of
-    # zeros; the effect is a difference in CLR units, not a fold change.
+    # Welch's two-sample t test on centred log-ratios after multiplicative
+    # replacement of zeros (zCompositions::cmultRepl); the effect is a difference
+    # in CLR units, not a fold change.
     method: nb_glm
     # How library size enters each model, as a log offset: tss (total reads per
     # sample) or rle (median-of-ratios over the taxa present in every sample).
@@ -359,8 +360,16 @@ analysis:
     offset: tss
     # Fraction of samples, 0 to 1, in which a taxon must have reads to be
     # tested. Taxa below it are listed as filtered, without a p-value.
-    min_prevalence: 0.0
-    # clr_lm only: a zero is replaced by this fraction, between 0 and 1, of the
-    # taxon's smallest observed count, and the other counts in the sample are
-    # scaled down so its total is unchanged. A replaced zero is not a measurement.
+    # Under clr_lm this runs before zero replacement, which is what keeps the
+    # imputed values bounded: zeros are filled in only over the taxa the test is
+    # run on. Left near 0 on a shallow 16S library, a sample missing most of the
+    # composition gets most of its total from imputed values instead, and at some
+    # point there is nothing left to scale down. 0.25 is the tier where a taxon
+    # has to show in a quarter of the samples to be believed at all.
+    min_prevalence: 0.25
+    # clr_lm only: cmultRepl's frac, between 0 and 1. A zero is replaced by this
+    # fraction of its replacement limit - the smaller of half the sample's own
+    # per-taxon threshold and the taxon's smallest observed proportion anywhere -
+    # and the other values in the sample are scaled down so its total is
+    # unchanged. A replaced zero is not a measurement.
     replacement_delta: 0.65
