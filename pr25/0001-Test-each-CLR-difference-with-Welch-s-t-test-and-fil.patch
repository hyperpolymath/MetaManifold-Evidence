+
+describe('a Welch t test result', () => {
+  // The numbers are the effect fixture's first taxon, as real R computes them
+  // (estimate 1.7772749137343919, t 6.9493417212103958 on 21.773496214508405 df).
+  const welch: DifferentialResult = {
+    ...result,
+    method: "Welch's t test per taxon (stats::t.test with var.equal = FALSE) on centred log-ratios",
+    effect: { key: 'estimate', label: 'CLR difference' },
+    config: { method: 'clr_lm', min_prevalence: 0.25, replacement_delta: 0.65 },
+    diagnostics: {
+      ...result.diagnostics,
+      fit_method: 'stats::t.test (Welch, var.equal = FALSE)',
+      zero_replacement: {
+        operator: 'zCompositions::cmultRepl', delta: 0.65, threshold: 0.5,
+        zeros_replaced: 0, n_samples_replaced: 0, n_taxa_in_composition: 3,
+        n_taxa_excluded: 0, n_taxa_unobserved: 0,
+        max_imputed_fraction: 0, median_imputed_fraction: 0,
+      },
+    },
+    rows: [
+      { taxon: 't_up', status: 'ok', note: '', estimate: 1.7772749137343919, log2_fold_change: null,
+        standard_error: 0.25574723262059357, statistic: 6.9493417212103958, pvalue: 5.9559757223049031e-7,
+        df: 21.773496214508405, padj: 8.934e-7, dispersion_theta: null, prevalence: 1 },
+      { taxon: 'rare', status: 'filtered', note: 'present in 1 of 24 samples, below analysis.differential.min_prevalence = 0.25',
+        estimate: null, log2_fold_change: null, standard_error: null, statistic: null, pvalue: null,
+        df: null, padj: null, dispersion_theta: null, prevalence: 1 / 24 },
+    ],
+  }
+
+  test('the degrees of freedom are exported beside the p-value they belong to', () => {
+    const lines = differentialCsv(welch).trimEnd().split('\r\n')
+    // JavaScript's shortest round-tripping form of each number: R prints
+    // 1.7772749137343919 and String() gives 1.777274913734392. Same double, so
+    // the CSV still reads back to the exact value R computed.
+    expect(lines[4]).toBe('t_up,ok,,1.777274913734392,0.25574723262059357,6.949341721210396,5.955975722304903e-7,21.773496214508405,8.934e-7,,1,')
+    expect(lines[1]).toContain("stats::t.test with var.equal = FALSE")
+  })
+
+  test('a taxon the prevalence filter dropped keeps its reason and no numbers', () => {
+    const lines = differentialCsv(welch).trimEnd().split('\r\n')
+    expect(lines[5]).toBe('rare,filtered,,,,,,,,,0.041666666666666664,"present in 1 of 24 samples, below analysis.differential.min_prevalence = 0.25"')
+  })
+
+  test('the settings line says the filter ran before the replacement', () => {
+    expect(configLine(welch)).toBe('method clr_lm, replacement_delta 0.65, min_prevalence 0.25 (applied before zero replacement); estimate is a CLR difference, not a fold change')
+  })
+
+  test('the diagnostics name the operator, so a run records what it used', () => {
+    const z = welch.diagnostics.zero_replacement!
+    expect(z.operator).toBe('zCompositions::cmultRepl')
+    expect(welch.diagnostics.fit_method).toBe('stats::t.test (Welch, var.equal = FALSE)')
+  })
+})
