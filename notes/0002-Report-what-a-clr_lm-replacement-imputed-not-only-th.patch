 const result: DifferentialResult = {
   status: 'partial',
@@ -74,3 +74,42 @@ describe('clr_lm results', () => {
     expect(differentialCsv(clr).split('\r\n')[2]).toBe(`# ${configLine(clr)}`)
   })
 })
+
+describe('what a clr_lm replacement imputed', () => {
+  type Zr = NonNullable<DifferentialResult['diagnostics']['zero_replacement']>
+  const withZr = (zr: Zr, minPrevalence = 0.1): DifferentialResult => ({
+    ...result,
+    method: 'CLR LM',
+    effect: { key: 'estimate', label: 'CLR difference' },
+    config: { method: 'clr_lm', min_prevalence: minPrevalence, replacement_delta: 0.65 },
+    diagnostics: { ...result.diagnostics, zero_replacement: zr },
+  })
+
+  test('a result with no replacement to report says nothing', () => {
+    expect(zeroReplacementLine(result)).toBe('')
+    expect(zeroReplacementLine({ ...result, method: 'CLR LM' })).toBe('')
+  })
+
+  test('a table with no zeros says so instead of claiming a replacement', () => {
+    const line = zeroReplacementLine(withZr({
+      delta: 0.65, zeros_replaced: 0, n_taxa_in_composition: 4, n_taxa_unobserved: 0,
+      max_imputed_fraction: 0, median_imputed_fraction: 0, n_samples_over_10_percent: 0,
+      via: 'none (no zeros to replace)',
+    }))
+    expect(line).toBe(' Nothing was imputed: the 4 taxa at or above min_prevalence 0.1 have no zeros.')
+  })
+
+  test('the median share is reported next to the worst one, and named as not a measurement', () => {
+    const line = zeroReplacementLine(withZr({
+      delta: 0.65, zeros_replaced: 9437, n_taxa_in_composition: 18, n_taxa_unobserved: 1,
+      max_imputed_fraction: 0.08, median_imputed_fraction: 0.011, n_samples_over_10_percent: 0,
+      via: 'zCompositions::multRepl',
+    }, 0.1))
+    expect(line).toContain('9437 zeros replaced by zCompositions::multRepl (frac 0.65)')
+    expect(line).toContain('1.1% of the median sample')
+    expect(line).toContain('at most 8.0% of any sample')
+    expect(line).toContain('over 10% in 0 of them')
+    expect(line).toContain('a replaced value is not a measurement')
+    expect(line).toContain('the 18 taxa the log-ratios are taken over')
+  })
+})
diff --git a/frontend/src/components/differentialTable.ts b/frontend/src/components/differentialTable.ts
index be40d98..6468c6d 100644
--- a/frontend/src/components/differentialTable.ts
+++ b/frontend/src/components/differentialTable.ts
@@ -55,3 +55,24 @@ export function configLine(result: DifferentialResult): string {
 export function effectValue(result: DifferentialResult, row: DifferentialRow): number | null {
   return row[result.effect.key]
 }
+
+/**
+ * What a `clr_lm` analysis imputed, in one sentence: how many zeros, by which
+ * code, and how much of each sample the result now rests on. A table with no
+ * zeros says so rather than reporting a replacement that did not happen.
+ */
+export function zeroReplacementLine(result: DifferentialResult): string {
+  const z = result.diagnostics.zero_replacement
+  if (!z) return ''
+  if (z.zeros_replaced === 0) {
+    return ` Nothing was imputed: the ${z.n_taxa_in_composition} taxa at or above ` +
+      `min_prevalence ${result.config.min_prevalence} have no zeros.`
+  }
+  const pct = (v: number) => `${(100 * v).toPrecision(2)}%`
+  return ` ${z.zeros_replaced} zeros replaced by ${z.via} (frac ${z.delta}). They hold ` +
+    `${pct(z.median_imputed_fraction)} of the median sample and at most ` +
+    `${pct(z.max_imputed_fraction)} of any sample, over 10% in ` +
+    `${z.n_samples_over_10_percent} of them, and a replaced value is not a measurement. ` +
+    `min_prevalence ${result.config.min_prevalence} chose the ${z.n_taxa_in_composition} ` +
+    `taxa the log-ratios are taken over.`
+}
