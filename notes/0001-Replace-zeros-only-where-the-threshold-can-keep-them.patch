-const _FIT_LM_R = raw"""
+"""
+    clr_composition(counts, prevalence, min_prevalence) -> Tuple{Vector{Int},Vector{Int}}
+
+Which columns of a samples x taxa count matrix a `clr_lm` analysis replaces
+zeros in, transforms and tests: `in_composition` holds every taxon seen in at
+least `min_prevalence` of the samples, and `unobserved` those with no reads
+anywhere, which have no detection limit to impute towards.
+
+The threshold is applied here, before the transform, and not after it.
+Replacing zeros across every taxon ever seen lets the imputed values dominate a
+thin sample: on a 66-sample 18S table of 1,490 ASVs with 95% zeros they held
+47% of the median sample's total and more than the whole total in 9 of the 66,
+which is a refusal rather than a result, and raising the threshold to 0.1 brought
+that to a 1% median and an 8% worst case. What is given up is real: a taxon
+below the threshold no longer shapes every other taxon's log-ratio, because the
+centred log-ratio is taken over the kept set. The diagnostics say how much of
+each sample was imputed either way, so the trade is visible in the result.
+"""
+function clr_composition(counts::AbstractMatrix{<:Real}, prevalence::AbstractVector{<:Real},
+                         min_prevalence::Real)
+    in_composition = Int[]
+    unobserved = Int[]
+    for j in axes(counts, 2)
+        if count(>(0), view(counts, :, j)) == 0
+            push!(unobserved, j)
+        elseif prevalence[j] >= min_prevalence
+            push!(in_composition, j)
+        end
+    end
+    (in_composition, unobserved)
+end
